+/// Ask Cargo to expand its build-dir templates. Only enroll directories inside
+/// the explicitly managed root: project overrides must never widen GC's scope.
+pub fn invocation_build_dir(
+    cargo: &Path,
+    args: &[OsString],
+    cwd: &Path,
+    workspace: &Path,
+) -> Option<PathBuf> {
+    let root = PathBuf::from(std::env::var_os("CARGO_OVERSTAY_BUILD_ROOT")?);
+    if !root.is_absolute() {
+        return None;
+    }
+    let mut command = command(cargo).ok()?;
+    if let Some(toolchain) = args
+        .first()
+        .filter(|arg| arg.to_string_lossy().starts_with('+'))
+    {
+        command.arg(toolchain);
+    }
+    command
+        .args([
+            "metadata",
+            "--offline",
+            "--no-deps",
+            "--format-version=1",
+            "--manifest-path",
+        ])
+        .arg(workspace.join("Cargo.toml"));
+    for value in option_values(args, "--config") {
+        command.arg("--config").arg(value);
+    }
+    let output = command
+        .current_dir(cwd)
+        .stdin(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .output()
+        .ok()?;
+    if !output.status.success() {
+        return None;
+    }
+    let metadata: serde_json::Value = serde_json::from_slice(&output.stdout).ok()?;
+    owned_build_dir(
+        Path::new(metadata.get("build_directory")?.as_str()?),
+        &root,
+        workspace,
+    )
+}
+
+fn owned_build_dir(path: &Path, root: &Path, workspace: &Path) -> Option<PathBuf> {
+    let root = root.canonicalize().ok()?;
+    let path = path.canonicalize().ok()?;
+    let workspace = workspace.canonicalize().ok()?;
+    if path == root
+        || !path.starts_with(&root)
+        || workspace.starts_with(&path)
+        || !path.is_dir()
+        || path.join("Cargo.toml").exists()
+        || path.join(".git").exists()
+    {
+        return None;
+    }
+    Some(path)
 }
 
