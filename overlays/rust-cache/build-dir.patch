+/// Kache's adaptive incremental payloads are siblings of Cargo's incremental
+/// directory. Hold both the Cargo profile lock and Kache's unit lock, keeping
+/// the unit's lock inode and policy metadata in place for the next compile.
+fn kache_incremental_units(profile: &Path, now: i64, locks: &mut Vec<File>) -> Vec<Unit> {
+    let mut units = Vec::new();
+    let auto = profile.join("incremental.kache-auto");
+    let root = profile.join("incremental.kache-auto/v1");
+    if !std::fs::symlink_metadata(&auto).is_ok_and(|m| m.is_dir())
+        || !std::fs::symlink_metadata(&root).is_ok_and(|m| m.is_dir())
+    {
+        return units;
+    }
+    let Ok(entries) = std::fs::read_dir(root) else {
+        return units;
+    };
+    for entry in entries.flatten() {
+        let name = entry.file_name();
+        let name = name.to_string_lossy();
+        if name.len() != 64
+            || !name.bytes().all(|b| b.is_ascii_hexdigit())
+            || !entry.file_type().is_ok_and(|t| t.is_dir())
+        {
+            continue;
+        }
+        let path = entry.path();
+        let payload = path.join("rustc");
+        if !std::fs::symlink_metadata(path.join("state.json")).is_ok_and(|m| m.is_file())
+            || !std::fs::symlink_metadata(path.join("unit.lock")).is_ok_and(|m| m.is_file())
+            || !std::fs::symlink_metadata(&payload).is_ok_and(|m| m.is_dir())
+        {
+            continue;
+        }
+        let Ok(lock) = File::open(path.join("unit.lock")) else {
+            continue;
+        };
+        if lock.try_lock().is_err() {
+            continue;
+        }
+        locks.push(lock);
+        let (_, newest) = dir_stat(&path);
+        units.push(Unit {
+            live: true,
+            last_used: newest.min(now),
+            size: crate::size::dir_size(&payload),
+            paths: vec![payload],
+        });
+    }
+    units
+}
