+/// Convert an SDR gamma-control ramp to the PQ code values used by an HDR output.
+/// Below reference white, evaluate the original ramp in gamma-2.2 SDR signal space;
+/// above it, continue with the ramp's endpoint gain to preserve HDR headroom.
+fn hdr_gamma_from_sdr(ramp: &[u16], reference_luminance: f64) -> Vec<u16> {
+    let size = ramp.len() / 3;
+    if size < 2 || ramp.len() != size * 3 {
+        return ramp.to_vec();
+    }
+
+    const M1: f64 = 0.1593017578125;
+    const M2: f64 = 78.84375;
+    const C1: f64 = 0.8359375;
+    const C2: f64 = 18.8515625;
+    const C3: f64 = 18.6875;
+
+    let pq_decode = |signal: f64| {
+        let p = signal.clamp(0.0, 1.0).powf(1.0 / M2);
+        ((p - C1).max(0.0) / (C2 - C3 * p)).powf(1.0 / M1)
+    };
+    let pq_encode = |linear: f64| {
+        let y = linear.clamp(0.0, 1.0).powf(M1);
+        ((C1 + C2 * y) / (1.0 + C3 * y)).powf(M2)
+    };
+    let reference = (reference_luminance / 10_000.0).clamp(0.0001, 1.0);
+    let mut converted = vec![0; ramp.len()];
+
+    for channel in 0..3 {
+        let source = &ramp[channel * size..(channel + 1) * size];
+        let target = &mut converted[channel * size..(channel + 1) * size];
+        let endpoint_gain = (f64::from(source[size - 1]) / 65535.0).powf(2.2);
+        for (index, value) in target.iter_mut().enumerate() {
+            let pq_signal = index as f64 / (size - 1) as f64;
+            let linear = pq_decode(pq_signal);
+            let adjusted = if linear <= reference {
+                let sdr_signal = (linear / reference).powf(1.0 / 2.2);
+                let position = sdr_signal * (size - 1) as f64;
+                let lower = position.floor() as usize;
+                let upper = (lower + 1).min(size - 1);
+                let fraction = position - lower as f64;
+                let mapped = f64::from(source[lower]) * (1.0 - fraction)
+                    + f64::from(source[upper]) * fraction;
+                (mapped / 65535.0).powf(2.2) * reference
+            } else {
+                linear * endpoint_gain
+            };
+            *value = (pq_encode(adjusted) * 65535.0).round() as u16;
+        }
+    }
+
+    converted
 }
 
