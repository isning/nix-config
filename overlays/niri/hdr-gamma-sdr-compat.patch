+    #[test]
+    fn hdr_gamma_ramp_preserves_sdr_night_light_strength() {
+        let size = 1024;
+        let gains = [1.0, 0.807, 0.651];
+        let ramp = gains
+            .into_iter()
+            .flat_map(|gain| {
+                (0..size).map(move |index| {
+                    (gain * index as f64 / (size - 1) as f64 * 65535.0).round() as u16
+                })
+            })
+            .collect::<Vec<_>>();
+        let converted = hdr_gamma_from_sdr(&ramp, 203.0);
+
+        let pq_reference = {
+            let m1 = 0.1593017578125_f64;
+            let m2 = 78.84375_f64;
+            let y = (203.0_f64 / 10_000.0).powf(m1);
+            ((0.8359375 + 18.8515625 * y) / (1.0 + 18.6875 * y)).powf(m2)
+        };
+        let index = (pq_reference * (size - 1) as f64).round() as usize;
+        let red = f64::from(converted[index]);
+        let green = f64::from(converted[size + index]);
+        let blue = f64::from(converted[2 * size + index]);
+        assert!(red > green && green > blue);
+        // Multiplying PQ codes directly by 0.651 would give approximately 25 nits;
+        // the converted ramp gives approximately 79 nits at a 203-nit reference white.
+        assert!((blue / red - 0.83).abs() < 0.03);
+        assert!((green / red - 0.916).abs() < 0.01);
+    }
