@@ -162,6 +162,14 @@ ProcessResult AsciiComposer::ProcessCapsLock(const KeyEvent& key_event) {
       return kRejected;
     }
   }
+  // Caps Lock may be turned off while another input method or window has
+  // focus. The retained session then misses the Caps_Lock event, so reconcile
+  // only ASCII mode entered through Caps Lock with the current modifier mask.
+  if (good_old_caps_lock_ && toggle_with_caps_ && !key_event.caps()) {
+    toggle_with_caps_ = false;
+    SwitchAsciiMode(false, caps_lock_switch_style_);
+  }
+
   if (key_event.caps()) {
     if (!good_old_caps_lock_ && !key_event.release() && !key_event.ctrl() &&
