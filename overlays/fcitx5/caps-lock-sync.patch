diff --git a/test/caps_lock_sync_test.cc b/test/caps_lock_sync_test.cc
new file mode 100644
--- /dev/null
+++ b/test/caps_lock_sync_test.cc
@@ -0,0 +1,56 @@
+#include <gtest/gtest.h>
+#include <rime/config.h>
+#include <rime/context.h>
+#include <rime/engine.h>
+#include <rime/key_event.h>
+#include <rime/processor.h>
+#include <rime/schema.h>
+
+using namespace rime;
+
+class CapsLockSyncTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    engine.reset(Engine::Create());
+    auto* config = engine->schema()->config();
+    config->SetBool("ascii_composer/good_old_caps_lock", true);
+    config->SetString("ascii_composer/switch_key/Caps_Lock", "commit_code");
+    config->SetString("ascii_composer/switch_key/Shift_L", "commit_text");
+    auto* component = Processor::Require("ascii_composer");
+    ASSERT_NE(nullptr, component);
+    composer.reset(component->Create(engine.get()));
+    engine->context()->set_option("ascii_mode", false);
+  }
+
+  void PressCapsLock() {
+    composer->ProcessKeyEvent(KeyEvent(XK_Caps_Lock, 0));
+    composer->ProcessKeyEvent(KeyEvent(XK_Caps_Lock, kLockMask | kReleaseMask));
+    ASSERT_TRUE(engine->context()->get_option("ascii_mode"));
+  }
+
+  the<Engine> engine;
+  the<Processor> composer;
+};
+
+TEST_F(CapsLockSyncTest, LockDisabledOutsideSession) {
+  PressCapsLock();
+  // Another window handles Caps Lock off. This session sees only the next key.
+  composer->ProcessKeyEvent(KeyEvent('a', 0));
+  EXPECT_FALSE(engine->context()->get_option("ascii_mode"));
+}
+
+TEST_F(CapsLockSyncTest, UppercaseStillPassesThrough) {
+  PressCapsLock();
+  EXPECT_EQ(kRejected, composer->ProcessKeyEvent(KeyEvent('A', kLockMask)));
+  EXPECT_TRUE(engine->context()->get_option("ascii_mode"));
+  composer->ProcessKeyEvent(KeyEvent(XK_Caps_Lock, kLockMask));
+  EXPECT_FALSE(engine->context()->get_option("ascii_mode"));
+}
+
+TEST_F(CapsLockSyncTest, ShiftSelectedEnglishIsPreserved) {
+  composer->ProcessKeyEvent(KeyEvent(XK_Shift_L, kShiftMask));
+  composer->ProcessKeyEvent(KeyEvent(XK_Shift_L, kReleaseMask));
+  ASSERT_TRUE(engine->context()->get_option("ascii_mode"));
+  composer->ProcessKeyEvent(KeyEvent('a', 0));
+  EXPECT_TRUE(engine->context()->get_option("ascii_mode"));
+}
